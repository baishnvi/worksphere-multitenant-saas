{
  "openapi": "3.0.3",
  "info": {
    "title": "WorkSphere Multi-Tenant API",
    "version": "1.0.0",
    "description": "Production REST API for multi-tenant project planning, task management, RBAC, and workflow automation."
  },
  "servers": [
    {
      "url": "http://localhost:5000/api/v1",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health probe",
        "responses": {
          "200": { "description": "Backend is healthy" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate user and issue JWT token pair",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "JWT Access & Refresh token returned" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/tasks": {
      "get": {
        "summary": "List tasks scoped to tenant organization",
        "parameters": [
          { "name": "projectId", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Array of tasks returned" }
        }
      },
      "post": {
        "summary": "Create new task with initial OCC version 1",
        "responses": {
          "201": { "description": "Task created" }
        }
      }
    },
    "/tasks/{id}": {
      "patch": {
        "summary": "Update task with Optimistic Concurrency Control (OCC)",
        "description": "Requires expectedVersion. If expectedVersion != task.version, returns 409 Conflict.",
        "responses": {
          "200": { "description": "Task updated and version incremented" },
          "409": { "description": "Concurrency Conflict" }
        }
      }
    }
  }
}
