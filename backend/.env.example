# WorkSphere Backend Environment Variables
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database Configuration
DATABASE_URL=postgresql://worksphere_user:worksphere_pass@localhost:5432/worksphere_db?schema=public

# Security & Authentication
JWT_ACCESS_SECRET=worksphere_super_secret_access_jwt_key_2026!
JWT_REFRESH_SECRET=worksphere_super_secret_refresh_jwt_key_2026!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Microservices Communication
ANALYTICS_SERVICE_URL=http://localhost:8000
ANALYTICS_SERVICE_API_KEY=ws_internal_service_key_998877

# Redis & Job Queues
REDIS_HOST=localhost
REDIS_PORT=6379

# Client CORS
CLIENT_ORIGIN=http://localhost:3000
